# Copy to .env and fill in — the analysis machine's trigger_mcp_server.py address.
# Used only by trigger_mcp_client.py to manually kick off an analysis run.
ANALYSIS_SERVER_URL=http://<analysis-machine-ip>:8001/mcp

# Only needed if this vault's real data root isn't /rationalVault/data.
# Used by mcp_server.py's upload_file to know where to write reports back to.
# DATA_ROOT=/rationalVault/data
